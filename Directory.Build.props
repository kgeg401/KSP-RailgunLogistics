<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <KspRoot Condition="'$(KspRoot)'==''">$(MSBuildThisFileDirectory)../Kerbal Space Program</KspRoot>
    <LunaRoot Condition="'$(LunaRoot)'==''">$(MSBuildThisFileDirectory)../LunaMultiplayerServer</LunaRoot>
    <Version>0.2.0</Version>
    <Deterministic>true</Deterministic>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
</Project>
